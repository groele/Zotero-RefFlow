cache-partialMinutes = 部分结果（分钟）
cache-duration-help = 天数设为 0 时保留至手动刷新。条目或附件变化会使旧结果失效，达到存储上限时会清理较久未用的列表。
cache-capacity-heading = 存储配额与空间管理
cache-file-path = 缓存文件夹
cache-open-folder = 打开缓存文件夹
cache-max-mib = 缓存容量上限（MiB）
cache-max-items = 缓存论文数量上限
cache-capacity-help = 每篇论文单独保存 JSON 文件，轻量索引保存在 index.json 中。论文文件容量支持 1–64 MiB、数量支持 10–10000 篇，索引另行统计。达到上限时优先清理过期列表，再淘汰较久未用的论文。单篇上限为 2 MiB。降低上限后，部分论文可能需要重新获取。
cache-status-heading = 运行统计与健康状态
cache-usage-loading = 正在读取缓存占用…
cache-usage = 论文文件已占用 { $used } / { $limit } MiB，{ $items } / { $maxItems } 篇，索引 { $index } KiB。本次运行已淘汰 { $evicted } 篇、清理 { $expired } 个过期列表、跳过 { $skipped } 次超限保存。
cache-usage-memory = 当前仅使用内存缓存，已占用 { $used } MiB、{ $items } 篇。数据目录不可用，退出后需要重新获取。
cache-usage-failed = 缓存写入失败，内存中有 { $items } 篇、{ $used } MiB，部分更新尚未保存。可点击清理过期缓存重试写入。
cache-clean-expired = 清理过期缓存
cache-cleanup-help = 启动时、有效期修改后及运行期间每 10 分钟清理过期列表。完整列表默认有效 30 天。关闭缓存开关后仍会按有效期执行维护。
range-percent = { $percent }%
unit-px = px
service-badge-api = API
